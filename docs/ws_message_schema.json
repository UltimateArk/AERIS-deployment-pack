{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EngineState WS Message v2.2",
  "description": "Broadcast per tick @100Hz while running. Backend ML adds predicted_fault/confidence/is_anomaly/trend/rul_hours/advisory (see backend).",
  "type": "object",
  "required": ["t", "rpm", "cht", "egt", "map", "oilPressure", "oilTemp",
               "fuelFlow", "vibRMS", "faultCode", "mission_id", "seq"],
  "properties": {
    "t": { "type": "number", "description": "total engine run seconds (drives wear, never reset by start)" },
    "mission_id": { "type": "integer", "description": "mission counter, fresh on every /engine/start" },
    "mission_t": { "type": "number", "description": "seconds since this mission started (replay clock)" },
    "wall_ts": { "type": "number", "description": "PC epoch seconds at tick (real-world anchor)" },
    "seq": { "type": "integer", "description": "global step counter (drop detector)" },
    "rpm": { "type": "number", "minimum": 0, "maximum": 10000 },
    "cht": { "type": "number", "minimum": 30, "maximum": 850 },
    "egt": { "type": "number", "minimum": 250, "maximum": 950 },
    "egt1": { "type": "number" },
    "egt2": { "type": "number" },
    "egt3": { "type": "number" },
    "egt4": { "type": "number" },
    "egtSpread": { "type": "number" },
    "map": { "type": "number", "minimum": 0.8, "maximum": 2.5 },
    "oilPressure": { "type": "number", "minimum": 0.3, "maximum": 5 },
    "oilTemp": { "type": "number", "minimum": 20, "maximum": 130 },
    "fuelFlow": { "type": "number", "minimum": 0, "maximum": 5 },
    "vibX": { "type": "number" },
    "vibY": { "type": "number" },
    "vibZ": { "type": "number", "minimum": 0, "maximum": 0.5 },
    "vibRMS": { "type": "number" },
    "battV": { "type": "number", "minimum": 20, "maximum": 29 },
    "altA": { "type": "number", "minimum": 0, "maximum": 25 },
    "injTiming": { "type": "number", "minimum": 10, "maximum": 30 },
    "powerKw": { "type": "number", "minimum": 0, "maximum": 120 },
    "bsfc": { "type": "number", "minimum": 200, "maximum": 600 },
    "physRes": { "type": "number", "description": "fuel-shaft-heat residual kW (ML-only, not displayed)" },
    "faultCode": { "type": "integer", "minimum": 0, "maximum": 14 },
    "faultCodes": { "type": "array", "items": { "type": "integer" } },
    "faultOrigin": { "type": "object", "description": "{code: manual|cascade|degradation}" },
    "faultAge": { "type": "object", "description": "{code: seconds active}" },
    "altitude": { "type": "number" },
    "ambientT": { "type": "number" },
    "ambientP": { "type": "number" },
    "humidity": { "type": "number" },
    "rpm_cmd": { "type": "number" },
    "load_cmd": { "type": "number" },
    "afr_cmd": { "type": "number" },
    "cooling_cmd": { "type": "number" },
    "inj_cmd": { "type": "number" },
    "health": {
      "type": "object",
      "properties": {
        "oil": { "type": "number" }, "cool": { "type": "number" },
        "comb": { "type": "number" }, "vib": { "type": "number" },
        "elec": { "type": "number" }
      }
    },
    "faultCyl": { "type": "object", "description": "{fault: cylinder 1-4}" }
  }
}
